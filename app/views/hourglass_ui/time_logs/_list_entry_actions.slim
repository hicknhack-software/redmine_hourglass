- if policy(time_log).book?
  = link_to sprite_icon('time', ''), hourglass_ui_book_time_logs_path(time_log), class: 'icon icon-time js-show-inline-form', title: t('hourglass.ui.lists.button_book'), remote: true, data: {type: 'html'}
- if policy(time_log).change?
  = link_to sprite_icon('edit', ''), hourglass_ui_edit_time_logs_path(time_log), class: 'icon icon-edit js-show-inline-form', title: t(:button_edit), remote: true, data: {type: 'html'}
- if policy(time_log).destroy?
  = delete_link(hourglass_time_log_path(time_log), {title: t(:button_delete), remote: true, class: 'icon icon-del js-hourglass-remote'}, '')
